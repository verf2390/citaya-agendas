# Existing automation endpoints
N8N_PAYMENT_RESEND_WEBHOOK_URL=
N8N_CAMPAIGNS_WEBHOOK_URL=

# Server-only token security (payment credentials are persisted per tenant)
CITAYA_MANAGE_TOKEN_PEPPER=

# DTE production (server-only; fail-closed defaults)
DTE_PRODUCTION_ENABLED=false
DTE_MODE=lab
DTE_SII_ENV=certification
DTE_SIGNING_MODE=lab
DTE_PRODUCTION_SEED_URL=
DTE_PRODUCTION_TOKEN_URL=
DTE_PRODUCTION_UPLOAD_URL=
DTE_PRODUCTION_STATUS_URL=
DTE_PRODUCTION_TIMEOUT_MS=30000
DTE_PRODUCTION_STORAGE_BUCKET=dte-production-private
DTE_PRODUCTION_CAF_ROOT=
DTE_PRODUCTION_CERTIFICATE_ROOT=
DTE_PRODUCTION_PRIVATE_KEY_ROOT=
DTE_PRODUCTION_TRUST_ANCHOR_IDK=
DTE_PRODUCTION_TRUST_ANCHOR_PATH=
DTE_PRODUCTION_TRUST_ANCHOR_PROVENANCE=
DTE_PRODUCTION_TRUST_ANCHOR_SHA256=
DTE_PRODUCTION_DATA_KEY=
DTE_WORKER_SECRET=
DTE_AUTOMATIC_WORKER_ENABLED=false
DTE_AUTOMATIC_TARGET_OUTBOX_ID=

# M2M (Machine-to-Machine) credentials for automated integrations (n8n)
# JSON object mapping tenantId → secret (hex, 64+ chars)
# Example: {"<tenant_uuid>":"<secret_hex_64>"}
M2M_CREDENTIALS_JSON=

# Citaya AI Core (server-only; disabled by default)
CITAYA_AI_ENABLED=false
CITAYA_AI_PROVIDER=openai
CITAYA_AI_PROMPT_VERSION=citaya-app-assistant-v1
CITAYA_AI_OPENAI_MODEL=
OPENAI_API_KEY=
CITAYA_AI_OPENAI_ENDPOINT=https://api.openai.com/v1/responses
CITAYA_AI_LOCAL_ENDPOINT=
CITAYA_AI_LOCAL_ALLOW_HTTP_PRIVATE=false
CITAYA_AI_LOCAL_MODEL=
CITAYA_AI_LOCAL_AUTH_TOKEN=
CITAYA_AI_TIMEOUT_MS=20000
CITAYA_AI_MAX_OUTPUT_TOKENS=800
CITAYA_AI_DAILY_TOKEN_LIMIT=50000
CITAYA_AI_REQUESTS_PER_MINUTE=10

# Citaya local AI gateway (run on a dedicated LAN node, e.g. rg-master)
# Keep the gateway private; use a strong token whenever it binds outside loopback.
CITAYA_AI_GATEWAY_HOST=127.0.0.1
CITAYA_AI_GATEWAY_PORT=8787
CITAYA_AI_GATEWAY_TOKEN=
CITAYA_AI_GATEWAY_UPSTREAM_URL=
CITAYA_AI_GATEWAY_UPSTREAM_TOKEN=
CITAYA_AI_GATEWAY_TIMEOUT_MS=60000
