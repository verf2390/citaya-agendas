[Unit]
Description=Citaya automatic DTE outbox worker (single iteration)
After=citaya.service
Requires=citaya.service

[Service]
Type=oneshot
User=verf
WorkingDirectory=/home/verf/apps/citaya-agendas
EnvironmentFile=/home/verf/apps/citaya-agendas/.env.local
Environment=PATH=/home/verf/.nvm/versions/node/v20.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/verf/.nvm/versions/node/v20.20.0/bin/node /home/verf/apps/citaya-agendas/scripts/dte/run-automatic-worker-once.mjs
TimeoutStartSec=13min
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/verf/apps/citaya-agendas
