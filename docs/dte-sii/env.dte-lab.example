# Citaya DTE/SII LAB external files example
# Copy values to a local ignored env file or secure runtime environment.
# Do not commit real CAF, certificates, private keys, passwords, or .env.local.

DTE_MODE=lab
DTE_SII_ENV=certification
DTE_PERSISTENCE_BACKEND=supabase

DTE_CAF_PATH=/home/verf/secure/dte-lab/caf/caf-certification.xml
DTE_CAF_PRIVATE_KEY_PATH=/home/verf/secure/dte-lab/private/caf-private-key.pem
DTE_CERT_PATH=/home/verf/secure/dte-lab/certs/certificado-digital.pem
DTE_PRIVATE_KEY_PATH=/home/verf/secure/dte-lab/private/certificado-private-key.pem

DTE_CERTIFICATION_FOLIO=1
DTE_CERTIFICATION_DOC_TYPE=39
DTE_CERTIFICATION_OUTPUT_PATH=tmp/dte-certification/certification-envio-dte.xml

DTE_SII_SEED_URL=
DTE_SII_TOKEN_URL=
DTE_SII_SUBMIT_URL=
DTE_SII_STATUS_URL=
DTE_SII_ENABLE_SUBMIT=false
